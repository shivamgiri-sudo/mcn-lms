# Database (MySQL 8.x)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/lms_db"

# Server
PORT=4000
FRONTEND_URL=https://your-app.vercel.app
SESSION_SECRET=change-this-to-a-random-secret

# Google Drive (paste your service account JSON as a single line)
GOOGLE_SERVICE_ACCOUNT_JSON=''

# Optional: set to false to not serve frontend from backend
SERVE_FRONTEND=false

# HRMS Bridge (Supabase credentials for validating HRMS session tokens)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# HR API push endpoint (POST /api/emp-mapping) — set this in Render environment
HR_API_KEY=your-secret-hr-api-key-here
