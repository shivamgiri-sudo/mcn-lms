# LMS database (MySQL 8.x)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://lms_user:change-me@localhost:3306/lms_db"

# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000
SERVE_FRONTEND=false

# Sessions
SESSION_TTL_SECONDS=21600
# Reserved for the secure-cookie/session-hashing migration. Use at least 32 random bytes.
SESSION_SECRET=replace-with-a-long-random-secret

# LMS safety controls
# Keep false in normal environments. Use only for controlled troubleshooting.
LMS_SEQUENTIAL_UNLOCK_DISABLED=false
MAX_FILE_SIZE_MB=200
SCORM_MAX_FILE_SIZE_MB=500
UPLOAD_DIR=uploads

# HRMS database integration — no source-code fallbacks exist.
HRMS_DB_HOST=
HRMS_DB_PORT=3306
HRMS_DB_USER=
HRMS_DB_PASS=
HRMS_DB_NAME=mas_hrms
HRMS_DB_CONNECTION_LIMIT=5

# HRMS-to-LMS compatibility bridge
# Required for the bridge endpoint to operate. Prefer a signed-JWT integration in production.
BRIDGE_SECRET=replace-with-a-long-random-secret
# Privileged coordinator/admin SSO is disabled by default.
BRIDGE_ALLOW_PRIVILEGED=false

# HR employee-ID mapping service
HR_API_KEY=replace-with-a-long-random-secret

# Google Drive — choose service account or OAuth configuration
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/drive/oauth2callback
GOOGLE_API_KEY=

# Email and scheduled summaries
DAILY_SUMMARY_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SMTP_FROM=

# Optional SMS / WhatsApp integrations
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MCNLMS
MSG91_TEMPLATE_ID=
MSG91_WHATSAPP_TOKEN=
MSG91_WHATSAPP_INTEGRATED_NUMBER=

# Development-only demo seed. The seed script refuses to run this in production.
LMS_ALLOW_DEMO_SEED=false
LMS_SEED_COORDINATOR_PIN=
LMS_SEED_MANAGEMENT_PIN=
LMS_SEED_ADMIN_PASSWORD=
LMS_SEED_TRAINEE_PASSWORD=
# Optional JSON array, for example: [{"process":"Customer Service","lob":"Retail"}]
LMS_SEED_PROCESS_LOB_JSON=
