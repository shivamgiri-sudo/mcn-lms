# Database (MySQL 8.x)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/lms_db"

# Server
PORT=4000
FRONTEND_URL=https://your-app.vercel.app
SESSION_SECRET=replace-with-random-value
NODE_ENV=development

# Optional: set to false to not serve frontend from backend
SERVE_FRONTEND=false

# LMS safety controls
# Keep false/blank in production. Set true only for emergency troubleshooting.
LMS_SEQUENTIAL_UNLOCK_DISABLED=false
SESSION_TTL_SECONDS=21600
MAX_FILE_SIZE_MB=200
UPLOAD_DIR=uploads

# Google Drive
GOOGLE_SERVICE_ACCOUNT_JSON=''

# HRMS/LMS bridge
BRIDGE_SECRET=replace-with-random-value

# Legacy Supabase keys are not used by the MySQL-only bridge unless a validator is added.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# HR API push endpoint
HR_API_KEY=replace-with-random-value

# Daily email summary
DAILY_SUMMARY_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
