# LMS database (MySQL 8.x)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://lms_user:change-me@localhost:3306/lms_db"

# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000
SERVE_FRONTEND=false
TRUST_PROXY=false
JSON_BODY_LIMIT=2mb
FORM_BODY_LIMIT=2mb

# Sessions, recovery, and signed integration state
SESSION_TTL_SECONDS=21600
SESSION_SECRET=replace-with-at-least-32-random-characters
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
PASSWORD_RESET_TTL_MINUTES=15

# LMS safety controls
LMS_SEQUENTIAL_UNLOCK_DISABLED=false
LMS_ATTENDANCE_MIN_ACTIVITY_SECONDS=900
LMS_DOCUMENT_MIN_ACTIVITY_SECONDS=60
MAX_FILE_SIZE_MB=200
UPLOAD_DIR=uploads

# Run scheduled jobs on exactly one designated worker instance.
LMS_RUN_SCHEDULERS=false

# SCORM isolation
# Production must use a separate HTTPS origin that serves the SCORM storage directory.
SCORM_CONTENT_ORIGIN=
SCORM_MAX_FILE_SIZE_MB=500
SCORM_MAX_UNCOMPRESSED_MB=500
SCORM_MAX_ENTRIES=5000
# Development convenience only. Never enable in production.
SCORM_ALLOW_SAME_ORIGIN=false

# HRMS database integration — no source-code fallbacks exist.
HRMS_DB_HOST=
HRMS_DB_PORT=3306
HRMS_DB_USER=
HRMS_DB_PASS=
HRMS_DB_NAME=mas_hrms
HRMS_DB_CONNECTION_LIMIT=5

# HRMS-to-LMS compatibility bridge
BRIDGE_SECRET=replace-with-at-least-32-random-characters
BRIDGE_ALLOW_PRIVILEGED=false

# HR employee-ID mapping service
HR_API_KEY=replace-with-at-least-32-random-characters

# Google Drive — choose service account or OAuth configuration
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/drive/oauth2callback
GOOGLE_API_KEY=
# Required when OAuth tokens are persisted. AES-256-GCM key material is derived from this value.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DRIVE_TOKEN_FILE=drive-token.enc
DRIVE_MAX_FILES=5000
DRIVE_MAX_RECURSION_DEPTH=10

# Email and scheduled summaries
DAILY_SUMMARY_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SMTP_FROM=

# Optional SMS / WhatsApp integrations
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MCNLMS
MSG91_TEMPLATE_ID=
MSG91_WHATSAPP_TOKEN=
MSG91_WHATSAPP_INTEGRATED_NUMBER=

# Development-only demo seed. The seed script refuses to run this in production.
LMS_ALLOW_DEMO_SEED=false
LMS_SEED_COORDINATOR_PIN=
LMS_SEED_MANAGEMENT_PIN=
LMS_SEED_ADMIN_PASSWORD=
LMS_SEED_TRAINEE_PASSWORD=
# Optional JSON array, for example: [{"process":"Customer Service","lob":"Retail"}]
LMS_SEED_PROCESS_LOB_JSON=
