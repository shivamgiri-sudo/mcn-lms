{
  "name": "lms-platform-backend",
  "version": "1.0.0",
  "description": "LMS 2.0 Backend - Express + Prisma + MySQL",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --exec node src/server.js",
    "start": "npx prisma generate && node src/server.js",
    "postinstall": "prisma generate",
    "test": "node --test test/*.test.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:migrate-role-pins": "node prisma/migrateRolePins.js",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "mariadb": "^3.5.3",
    "morgan": "^1.11.0",
    "multer": "2.2.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.3",
    "prisma": "^7.9.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "googleapis-common": {
      "gaxios": "7.3.0"
    }
  }
}
