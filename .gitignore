# Dependencies
node_modules/
**/node_modules/

# Build outputs
frontend/dist/
**/dist/

# Environment files — NEVER commit these
**/.env
**/.env.*
!**/.env.example

# Prisma
backend/prisma/dev.db
backend/prisma/*.db-journal

# Uploads and release backups (user/production data — not in git)
backend/uploads/
backups/

# Live release approval and provenance records — retain in controlled evidence storage
# Templates remain versioned as *.example.json.
deploy/release-manifest.json
deploy/release-image-evidence.json
deploy/dr-reports/

# OAuth tokens persisted on the server — not in git
backend/drive-token.json
backend/drive-token.enc
backend/runtime/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Superpowers AI tool
.superpowers/
docs/superpowers/
frontend/.env.production

mysql-data/
backend/prisma/mysql_backup/
*.err
*.pid
