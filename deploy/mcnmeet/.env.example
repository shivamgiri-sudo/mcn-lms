# MCNmeet private Jitsi deployment.
# Copy to .env on the Linux/Docker host and replace every CHANGE_ME value.

CONFIG=./jitsi-config
HTTP_PORT=80
HTTPS_PORT=443
TZ=Asia/Kolkata
PUBLIC_URL=https://mcnmeet.local

# Use letsencrypt only when PUBLIC_URL is a real DNS name reachable from the internet.
ENABLE_LETSENCRYPT=0
LETSENCRYPT_DOMAIN=mcnmeet.local
LETSENCRYPT_EMAIL=lms-admin@example.com

# Internal auth. Guests can join only when a moderated LMS room allows them.
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=jwt
JWT_APP_ID=mcn-lms
JWT_APP_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_ACCEPTED_ISSUERS=mcn-lms
JWT_ACCEPTED_AUDIENCES=mcnmeet
JWT_ALLOW_EMPTY=0

# Branding and product identity.
APP_NAME=MCNmeet
JITSI_WATERMARK_LINK=https://mcnmeet.local
ENABLE_WELCOME_PAGE=0
DISABLE_DEEP_LINKING=1

# Media bridge ports. Open UDP 10000 and TCP 443/4443 on the host firewall.
JVB_PORT=10000
JVB_TCP_HARVESTER_DISABLED=false
JVB_TCP_PORT=4443

# Optional recording/transcription stack can be enabled later with Jibri.
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0
