# Copy to deploy/.env.production and replace every CHANGE_ME value.
LMS_IMAGE=registry.example.invalid/mcn-lms:REPLACE_WITH_COMMIT_SHA
LMS_SERVICE_ENV_FILE=.env.production
LMS_HTTP_PORT=4000
LMS_RELEASE_BASE_URL=https://lms.example.com
DEPLOYMENT_ID=production-REPLACE_WITH_RELEASE_ID
APP_VERSION=REPLACE_WITH_RELEASE_VERSION

# External MySQL 8 database. Use an application user with only LMS schema access.
DATABASE_URL=mysql://lms_app:CHANGE_ME_APPLICATION_DATABASE_PASSWORD@database.example.internal:3306/lms_production

# Pre-deployment backup connection. Prefer a dedicated backup user with read, lock,
# routine, trigger and event privileges but no application write permissions.
LMS_BACKUP_MODE=remote
MYSQL_BACKUP_HOST=database.example.internal
MYSQL_BACKUP_PORT=3306
MYSQL_BACKUP_USER=lms_backup
MYSQL_BACKUP_PASSWORD=CHANGE_ME_BACKUP_DATABASE_PASSWORD
MYSQL_BACKUP_DATABASE=lms_production
MYSQL_BACKUP_SSL_MODE=REQUIRED

NODE_ENV=production
PORT=4000
FRONTEND_URL=https://lms.example.com
API_URL=https://lms.example.com
SERVE_FRONTEND=true
TRUST_PROXY=true
JSON_BODY_LIMIT=2mb
FORM_BODY_LIMIT=2mb
# Keep blank when LMS may be framed only by itself. Add the exact HRMS origin when approved.
CSP_FRAME_ANCESTORS=
# Add an API origin only when it differs from FRONTEND_URL.
CSP_CONNECT_SRC=
# Add only approved additional iframe/media/image origins.
CSP_FRAME_SRC=
CSP_MEDIA_SRC=
CSP_IMG_SRC=

# Role-specific HttpOnly browser sessions and CSRF
SESSION_TTL_SECONDS=21600
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_TOUCH_INTERVAL_SECONDS=300
SESSION_SECRET=CHANGE_ME_MINIMUM_32_CHARACTER_SESSION_SECRET
CSRF_SECRET=CHANGE_ME_DIFFERENT_MINIMUM_32_CHARACTER_CSRF_SECRET
SESSION_FINGERPRINT_SECRET=CHANGE_ME_DIFFERENT_MINIMUM_32_CHARACTER_FINGERPRINT_SECRET
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=true
# Leave blank for same-host serving. Set a trusted parent domain only for approved sibling subdomains.
SESSION_COOKIE_DOMAIN=
LMS_ALLOW_BEARER_SESSION_COMPAT=false
LMS_ALLOW_ORIGINLESS_AUTH=false
SECURITY_ELEVATION_MINUTES=15
OAUTH_STATE_SECRET=CHANGE_ME_MINIMUM_32_CHARACTER_OAUTH_SECRET
PASSWORD_RESET_TTL_MINUTES=15

# Signed HRMS assertion → replay nonce → single-use browser handoff
HRMS_ASSERTION_SECRET=CHANGE_ME_MINIMUM_32_CHARACTER_HRMS_ASSERTION_SECRET
HRMS_ASSERTION_ISSUER=mcn-hrms
HRMS_ASSERTION_AUDIENCE=mcn-lms
HRMS_ASSERTION_MAX_TTL_SECONDS=120
HRMS_ASSERTION_CLOCK_SKEW_SECONDS=30
SSO_HANDOFF_TTL_SECONDS=90
BRIDGE_ALLOW_PRIVILEGED=false
BRIDGE_ALLOW_LEGACY_SECRET=false
# Retain only for a separately approved, time-boxed legacy transition.
BRIDGE_SECRET=CHANGE_ME_MINIMUM_32_CHARACTER_LEGACY_BRIDGE_SECRET
HR_API_KEY=CHANGE_ME_MINIMUM_32_CHARACTER_HR_API_KEY
GOOGLE_TOKEN_ENCRYPTION_KEY=CHANGE_ME_MINIMUM_32_CHARACTER_TOKEN_KEY

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=200
SCORM_CONTENT_ORIGIN=https://scorm.example.com
SCORM_ALLOW_SAME_ORIGIN=false
SCORM_MAX_FILE_SIZE_MB=500
SCORM_MAX_UNCOMPRESSED_MB=500
SCORM_MAX_ENTRIES=5000

LMS_RUN_SCHEDULERS=false
LMS_RUNTIME_LEASE_SECONDS=300
LMS_READINESS_BACKLOG_LIMIT=5000
LMS_RUN_LOAD_SMOKE=true
LOAD_CONCURRENCY=25
LOAD_REQUESTS=500
LOAD_P95_LIMIT_MS=1500
LOAD_MAX_ERROR_PCT=1
LOAD_REQUEST_TIMEOUT_MS=5000

# Keep rollback disabled until an authorised incident decision is recorded.
ALLOW_APPLICATION_ROLLBACK=false
MIGRATION_COMPATIBILITY=backward-compatible

HRMS_DB_HOST=
HRMS_DB_PORT=3306
HRMS_DB_USER=
HRMS_DB_PASS=
HRMS_DB_NAME=mas_hrms
HRMS_DB_CONNECTION_LIMIT=5

GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lms.example.com/api/drive/oauth2callback
GOOGLE_API_KEY=
DRIVE_TOKEN_FILE=runtime/drive-token.enc
DRIVE_MAX_FILES=5000
DRIVE_MAX_RECURSION_DEPTH=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SMTP_FROM=
DAILY_SUMMARY_EMAILS=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=MCNLMS
MSG91_TEMPLATE_ID=
MSG91_WHATSAPP_TOKEN=
MSG91_WHATSAPP_INTEGRATED_NUMBER=

LMS_ALLOW_DEMO_SEED=false
