# Copy to deploy/.env.staging and replace every CHANGE_ME value.
LMS_IMAGE=mcn-lms:release-candidate
LMS_SERVICE_ENV_FILE=.env.staging
LMS_HTTP_PORT=4000
LMS_RELEASE_BASE_URL=http://127.0.0.1:4000
DEPLOYMENT_ID=staging-20260726
APP_VERSION=release-candidate

MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD
MYSQL_DATABASE=lms_staging
MYSQL_USER=lms_app
MYSQL_PASSWORD=CHANGE_ME_APPLICATION_DATABASE_PASSWORD
DATABASE_URL=mysql://lms_app:CHANGE_ME_APPLICATION_DATABASE_PASSWORD@mysql:3306/lms_staging
LMS_BACKUP_MODE=compose

NODE_ENV=production
PORT=4000
FRONTEND_URL=http://localhost:4000
API_URL=http://localhost:4000
SERVE_FRONTEND=true
TRUST_PROXY=false
JSON_BODY_LIMIT=2mb
FORM_BODY_LIMIT=2mb

SESSION_TTL_SECONDS=21600
SESSION_SECRET=CHANGE_ME_MINIMUM_32_CHARACTER_SESSION_SECRET
OAUTH_STATE_SECRET=CHANGE_ME_MINIMUM_32_CHARACTER_OAUTH_SECRET
BRIDGE_SECRET=CHANGE_ME_MINIMUM_32_CHARACTER_BRIDGE_SECRET
HR_API_KEY=CHANGE_ME_MINIMUM_32_CHARACTER_HR_API_KEY
GOOGLE_TOKEN_ENCRYPTION_KEY=CHANGE_ME_MINIMUM_32_CHARACTER_TOKEN_KEY
PASSWORD_RESET_TTL_MINUTES=15

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=200
SCORM_CONTENT_ORIGIN=https://scorm-staging.example.invalid
SCORM_ALLOW_SAME_ORIGIN=false
SCORM_MAX_FILE_SIZE_MB=500
SCORM_MAX_UNCOMPRESSED_MB=500
SCORM_MAX_ENTRIES=5000

LMS_RUN_SCHEDULERS=false
LMS_RUNTIME_LEASE_SECONDS=300
LMS_READINESS_BACKLOG_LIMIT=5000
LMS_RUN_LOAD_SMOKE=true
LOAD_CONCURRENCY=25
LOAD_REQUESTS=500
LOAD_P95_LIMIT_MS=1500
LOAD_MAX_ERROR_PCT=1
LOAD_REQUEST_TIMEOUT_MS=5000

HRMS_DB_HOST=
HRMS_DB_PORT=3306
HRMS_DB_USER=
HRMS_DB_PASS=
HRMS_DB_NAME=mas_hrms
HRMS_DB_CONNECTION_LIMIT=5
BRIDGE_ALLOW_PRIVILEGED=false

GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/drive/oauth2callback
GOOGLE_API_KEY=
DRIVE_TOKEN_FILE=drive-token.enc
DRIVE_MAX_FILES=5000
DRIVE_MAX_RECURSION_DEPTH=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SMTP_FROM=
DAILY_SUMMARY_EMAILS=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=MCNLMS
MSG91_TEMPLATE_ID=
MSG91_WHATSAPP_TOKEN=
MSG91_WHATSAPP_INTEGRATED_NUMBER=

LMS_ALLOW_DEMO_SEED=false
